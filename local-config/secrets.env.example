# ==============================================================================
# TEMPLATE -- copy this to "<environment>.secrets.env" (e.g.
# "development.secrets.env") and fill in real values. That copy is
# gitignored; this template is not.
#
# These become this repository's own GitHub Environment SECRETS (masked,
# never viewable again once set) for the matching environment, once you run:
#
#   scripts/bootstrap-environment.sh <environment> --set-secrets
#
# Do NOT put TF_AWS_ROLE_ARN here -- that value is computed by the apply
# itself, not something you decide, and the bootstrap script sets it
# automatically after a successful apply.
# ==============================================================================

# OPTIONAL. A GitHub token with read access to ASSETS_REPOSITORY (see
# vars.env.example), used by the plan and apply workflows to check it out. Only
# needed when ASSETS_REPOSITORY is set. Blank lines are skipped.
ASSETS_REPO_TOKEN=
