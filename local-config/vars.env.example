# ==============================================================================
# TEMPLATE -- copy this to "<environment>.vars.env" (e.g. "development.vars.env")
# and fill in real values. That copy is gitignored; this template is not.
#
# These become this repository's own GitHub Environment VARIABLES (visible,
# not masked) for the matching environment, once you run:
#
#   scripts/bootstrap-environment.sh <environment> --set-secrets
#
# Do NOT put TF_AWS_ROLE_ARN here -- that value is computed by the apply
# itself, not something you decide, and the bootstrap script sets it
# automatically after a successful apply.
# ==============================================================================

# AWS region this environment's resources live in. scripts/init-project.sh
# already sets AWS_REGION on the GitHub Environments, so this is normally left
# blank. Blank lines are skipped.
AWS_REGION=

# OPTIONAL. By default the assets uploaded to the assets bucket (the 502/503/504
# error pages, for example) are this repository's own assets/ folder. Set this
# to use a separate, independently versioned repository instead, in OWNER/REPO
# format, and set ASSETS_REPO_TOKEN in the secrets file. Leave blank for the
# default.
ASSETS_REPOSITORY=

# Tagged ref (branch, tag, or commit) of the assets repository. Only used when
# ASSETS_REPOSITORY is set; falls back to "main" if left blank.
ASSETS_REF=

# OPTIONAL. "immutable" (the default) or "classic": the OIDC subject format
# GitHub emits for this repository. Immutable embeds the numeric repository and
# owner IDs and applies to repositories created, renamed or transferred on or
# after 15 July 2026. Set classic for an older repository that still emits
# name-only subjects.
OIDC_SUBJECT_FORMAT=
