#!/usr/bin/env bash
# Fake gh for offline tests.
#   FAKE_GH_LOG        file that receives one line per call (and the JSON body of --input -)
#   FAKE_GH_REPO_JSON  served for "gh api repos/OWNER/REPO"
#   FAKE_GH_FAIL       make every "gh api" call fail
#   FAKE_GH_NO_USER    make "gh api users/..." fail
[[ -n "${FAKE_GH_LOG:-}" ]] && printf 'gh %s\n' "$*" >> "${FAKE_GH_LOG}"
if [[ "$*" == *"--input -"* ]]; then
  body="$(cat)"
  [[ -n "${FAKE_GH_LOG:-}" ]] && printf 'BODY %s\n' "${body}" >> "${FAKE_GH_LOG}"
fi
if [[ "$1" == "auth" ]]; then exit 0; fi
if [[ "$1" == "api" ]]; then
  if [[ -n "${FAKE_GH_FAIL:-}" ]]; then exit 1; fi
  if [[ "$2" =~ ^repos/[^/]+/[^/]+$ ]] && [[ -n "${FAKE_GH_REPO_JSON:-}" ]]; then
    printf '%s' "${FAKE_GH_REPO_JSON}"; exit 0
  fi
  if [[ "$2" =~ ^users/ ]]; then
    if [[ -n "${FAKE_GH_NO_USER:-}" ]]; then exit 1; fi
    printf '4242'; exit 0
  fi
  printf '{}'; exit 0
fi
exit 0
