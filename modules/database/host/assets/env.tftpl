# ==============================================================================
# DATABASE HOST RUNTIME ENVIRONMENT
#
# Configuration only -- no secrets. CORE_ROOT_SECRET_ARN is a pointer to the
# database administrator secret in Secrets Manager, not the secret itself.
#
# Read by update.sh and provision.sh.
# ==============================================================================

PROJECT_NAME=${project_name}
ENVIRONMENT=${environment}
SERVICE_NAME=${service_name}
DATABASE_WORKSPACE=${database_workspace}
DATA_ROOT=${data_root}
AWS_REGION=${aws_region}
DEPLOY_BUCKET_NAME=${deploy_bucket_name}
ECR_REGISTRY_URL=${ecr_registry_url}
ENABLE_ECR_ACCESS=${enable_ecr_access}
REQUIRE_ECR_IMAGES=${require_ecr_images}
CORE_ROOT_SECRET_ARN=${core_root_secret_arn}
