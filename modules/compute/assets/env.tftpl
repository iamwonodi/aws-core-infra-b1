# ==============================================================================
# FLEET RUNTIME ENVIRONMENT
#
# Platform-level values only -- no per-service configuration or secrets
# live here. Each service's own settings live in its own <service>/.env
# file, synced down separately from the fleet deploy bucket.
# ==============================================================================

PROJECT_NAME=${project_name}
ENVIRONMENT=${environment}
DEPLOY_BUCKET_NAME=${deploy_bucket_name}
FLEET_TIER=${fleet_tier}
AWS_REGION=${aws_region}
ECR_REGISTRY_URL=${ecr_registry_url}
